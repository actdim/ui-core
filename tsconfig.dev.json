{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "composite": true,
        "noEmit": true,
        "declaration": true,
        "emitDeclarationOnly": true,
        "declarationMap": true,
        "declarationDir": "./.out",
        "outDir": "./.out",
        "sourceMap": true,
        "inlineSources": true,
        "inlineSourceMap": false,
        "types": ["node", "vitest/globals", "vite/client"]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.json",
        "tests/**/*.ts",
        "tests/**/*.tsx",
        "scripts/**/*.ts",
        "packageConfig.ts",
        "package.json",
        "postcss.ts",
        "vite.config.ts",
        "vitest.node.config.ts",
        "vitest.setup.ts"
    ],
    "exclude": [".out", "dist", "node_modules"]
}
